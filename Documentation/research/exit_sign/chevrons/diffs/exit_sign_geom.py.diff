+# Punched chevron (research/exit_sign/chevrons/10_spec.md §1.3): the knockout is held by three
+# 1.5 mm tabs that the score leaves uncut (Tools/lookdev/gen_exit_sign.py: edges 0, 2 and 4 of
+# the CCW chevron polygon, a 0.75 mm radius gap at each edge midpoint). Punching it out breaks
+# the tabs and leaves a stub of plate 1.5 wide standing 0.35 proud into the hole at each one:
+# 4 points, sharp corners (a broken tab is not stamped, so no fillet).
+TAB_EDGES = (0, 2, 4)
+TAB_W = 1.5
+TAB_PROUD = 0.35
+
+
+def chevron_tab_stubs(side):
+    """The broken hold-tab stubs of the open chevron, in OPENING mm.
+    side: "left" (the < knockout) or "right" (>). Returns one dict per stub, in TAB_EDGES
+    order: edge (index in the CCW chevron polygon), mid (the edge midpoint = the texture's
+    tab centre), dir (unit edge direction), inward (unit left normal = into the hole) and
+    pts (the 4 hole-boundary points of the stub, in polygon order)."""
+    poly = letter_polys_open()["<" if side == "left" else ">"][0]
+    n = len(poly)
+    out = []
+    for e in TAB_EDGES:
+        a, b = poly[e], poly[(e + 1) % n]
+        dx, dy = b[0] - a[0], b[1] - a[1]
+        L = math.hypot(dx, dy)
+        tx, ty = dx / L, dy / L
+        nx, ny = -ty, tx
+        mx, my = (a[0] + b[0]) / 2, (a[1] + b[1]) / 2
+        h = TAB_W / 2
+        pts = [(mx - tx * h, my - ty * h), (mx - tx * h + nx * TAB_PROUD, my - ty * h + ny * TAB_PROUD),
+               (mx + tx * h + nx * TAB_PROUD, my + ty * h + ny * TAB_PROUD), (mx + tx * h, my + ty * h)]
+        out.append({"edge": e, "mid": (mx, my), "dir": (tx, ty), "inward": (nx, ny), "pts": pts})
+    return out
+
