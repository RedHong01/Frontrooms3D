+    // Exit-sign odds per profile (research/exit_sign/10_spec.md §8.2). A sign has its own
+    // circuit, so these never follow the troffers' dead/failing odds. Run: the level's red
+    // source must burn (no BATTERY, no DEAD), at most one LOOSE sign a room. Exit: the true
+    // exit never fails. Other profiles have no signs.
+    static void SignOdds(RoomRule rule, out float half, out float loose)
+    {
+        switch (rule)
+        {
+            case RoomRule.Run: half = .15f; loose = .15f; break;
+            default: half = 0f; loose = 0f; break;
+        }
+    }
+
+    /// <summary>
+    /// Deal the room's own signs their temperaments from the sequence hash: keys
+    /// sequence * 16 + 12 + i (the lamps use 0..11), so a recycled slot never repeats
+    /// its old signs and a room always shows the same ones.
+    /// </summary>
+    void ConfigureExitSigns(RoomSlot room)
+    {
+        var signs = room == null ? null : ActiveExitSigns(room);
+        if (signs == null) return;
+        SignOdds(room.rule, out var half, out var loose);
+        var sequence = Mathf.Max(0, room.sequence);
+        var looseTaken = false;
+        for (var i = 0; i < signs.Length; i++)
+        {
+            var sign = signs[i];
+            if (sign == null) continue;
+            var key = sequence * 16 + 12 + i;
+            var roll = Hash01(key, 89);
+            var temperament = FrontRoomsExitSign.Temperament.Lit;
+            if (roll < half) temperament = Hash01(key, 97) < .5f ? FrontRoomsExitSign.Temperament.HalfA : FrontRoomsExitSign.Temperament.HalfB;
+            else if (roll < half + loose && !looseTaken) { temperament = FrontRoomsExitSign.Temperament.Loose; looseTaken = true; }
+            sign.Configure((uint)key ^ 0x9E3779B9u, temperament, sign.RedLight, sign.LightBase);
+        }
+    }
