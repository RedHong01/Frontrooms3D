+E_MID = 48.0                              # E middle arm reaches x = 48 (6 mm short of the 54 arms)
+CH_H, CH_W = 57.15, 24.6                  # 2.25 in chevron, w/h 0.43
+CH_ARM = 0.45 * CH_W                      # 11.07 mm arm
+CH_GAP = 10.0                             # >= 3/8 in from the letters
