-    ZoneTheme[] BorderThemes(GridCoord cell, EdgeKind[] kinds)
+    // N1/V5 fix 2026-10-03: generatedOnly reads edges without generating a chunk (LampModeOf is
+    // pure); an edge whose chunk is not generated yet reads as Wall. BuildFixture generated every
+    // neighbour of a built lamp, so the two agree on built lamps.
+    ZoneTheme[] BorderThemes(GridCoord cell, EdgeKind[] kinds, bool generatedOnly = false)
     {
         for (var k = 0; k < 4; k++)
         {
             var n = k == 0 ? new GridCoord(cell.x + 1, cell.y) : k == 1 ? new GridCoord(cell.x - 1, cell.y) : k == 2 ? new GridCoord(cell.x, cell.y + 1) : new GridCoord(cell.x, cell.y - 1);
             borderThemes[k] = Cache.ZoneOf(n).theme;
