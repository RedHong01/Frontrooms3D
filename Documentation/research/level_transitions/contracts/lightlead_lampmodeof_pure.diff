+            kinds[k] = InStartArea(n) || InStartArea(cell) ? EdgeKind.Wall : generatedOnly ? GeneratedEdge(cell, n) : Cache.Edge(cell, n);
         }
         return borderThemes;
     }
 
+    // Cache.Edge for a generated chunk only (Wall where the owning chunk is not generated).
+    EdgeKind GeneratedEdge(GridCoord a, GridCoord b)
+    {
+        if (b.x < a.x || b.y < a.y) { var t = a; a = b; b = t; }
+        if (!Cache.TryGetGenerated(MapGrid.ChunkOf(a), out var data)) return EdgeKind.Wall;
+        var o = data.Origin;
+        var index = MapGrid.LocalIndex(a.x - o.x, a.y - o.y);
+        return b.x > a.x ? data.east[index] : data.north[index];
+    }
