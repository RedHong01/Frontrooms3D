+                uint h = a * 0x8DA6B343u + b * 0xD8163841u + c * 0xCB1AB31Fu + d * 0x165667B1u + 0x9E3779B9u;
+                h ^= h >> 16; h *= 0x7FEB352Du; h ^= h >> 15; h *= 0x846CA68Bu; h ^= h >> 16;
+                return h;
+            }
