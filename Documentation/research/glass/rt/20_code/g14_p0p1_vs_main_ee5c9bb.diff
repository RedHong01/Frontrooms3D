+        }
+        g_PoolUsed = 0;
+        if (!g_PoolPage) return nil;
+        AddStat(StGeoPages, 1);
+    }
+    base = g_PoolUsed;
+    g_PoolUsed += bytes;
+    if (g_PoolUsed > kPoolPageBytes / 2) PoolRequestSpareLocked();
+    return g_PoolPage;
+}
+
+void PoolReset()
+{
+    std::lock_guard<std::mutex> l(g_PoolMutex);
+    g_PoolPage = nil;
+    g_PoolSpare = nil;
+    g_PoolUsed = 0;
+    g_PoolGeneration++;
+}
